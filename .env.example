# Segredos (troque por valores longos e aleatórios)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
INTERNAL_API_KEY=troque-por-outra-chave-longa-e-aleatoria

# Tudo abaixo é opcional: os padrões já funcionam com o docker compose.
# Um banco por domínio: usuários e adoção em MongoDB (Atlas na nuvem)...
MONGO_URI_USUARIOS=mongodb://localhost:27017/miaudota_usuarios
MONGO_URI_ADOCAO=mongodb://localhost:27017/miaudota_adocao

# ...e feiras (geolocalização) em Azure SQL. Os padrões abaixo funcionam com o SQL Server do docker compose.
# No Azure: SQL_SERVER=<servidor>.database.windows.net, SQL_ENCRYPT=true, SQL_CRIAR_BANCO=false
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=miaudota_geolocalizacao
SQL_USER=sa
SQL_PASSWORD=Miaudota#Dev2026
SQL_ENCRYPT=false
SQL_CRIAR_BANCO=true

# Mensageria
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Portas e endereços dos processos
PORTA_GATEWAY=3000
PORTA_BFF=3001
PORTA_USUARIOS=3101
PORTA_ADOCAO=3102
PORTA_GEOLOCALIZACAO=3103
URL_BFF=http://localhost:3001
URL_USUARIOS=http://localhost:3101
URL_ADOCAO=http://localhost:3102
URL_GEOLOCALIZACAO=http://localhost:3103

# Notificação por e-mail (função de notificação -> webhook do n8n)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/miaudota-email
# Opcional: se definir, é enviado no cabeçalho x-miaudota-token (configure o mesmo valor em "Header Auth" no webhook do n8n)
N8N_WEBHOOK_TOKEN=

# Azure Function (indicador de adoção). Local: `func start` na pasta azure-function (porta 7071).
# Na nuvem: URL da função publicada e a chave dela (portal: Function App > App keys / Function keys).
FUNCTION_URL=http://localhost:7071/api/indicador-adocao
FUNCTION_KEY=
